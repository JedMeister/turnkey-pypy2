#! /usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export TMP=debian/tmp

%:
	dh $@

execute_before_dh_clean:
	# dh_clean will clean all other build files (in debian/tmp)
	rm -rf pypy-src
	rm -rf pypy-bin
	rm -rf pypy-build
	rm -rf tklbam-pypy2*

override_dh_auto_build:
	./pypy-build.sh

override_dh_strip:
	# nothing to do - build process already strips...
	# Note: this override MUST exist or dh_strip will fail for tklbam-pypy2 &
	# tklbam-pypy2-full; and it will strip tklbam-pypy2-dbg!
