#!/bin/sh
#
# This is a common postrm script for any/all of the TurnKey PyPy2 packages
# built by this source.
#
# It simply cleans up all the cached compiled .pyc files within the pypy2 file
# tree. This avoids the warning about non-empty directories not being removed
# because they should be empty.
#
# Note that it will clean the .pyc files from all subdirectories - including
# ones within the "site-packages" directories that belong to packages that
# depend on turnkey-pypy2*. When removing/purging this package, the dependant
# packages should do something similar themselves or they will show that
# warning.

set -e

find /usr/lib/tklbam-pypy2 -type f -name "*.pyc" -delete

# dh_installdeb will replace this comment with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
